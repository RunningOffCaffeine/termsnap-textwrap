{
  "name": "termsnap-textwrap",
  "displayName": "TermSnap TextWrap",
  "description": "Capture beautiful terminal screenshots with adjustable text wrapping, preserved terminal colors, and customizable themes.",
  "version": "0.1.1",
  "publisher": "RunningOffCaffeine",
  "icon": "media/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/RunningOffCaffeine/termsnap-textwrap"
  },
  "bugs": {
    "url": "https://github.com/RunningOffCaffeine/termsnap-textwrap/issues"
  },
  "keywords": [
    "terminal",
    "screenshot",
    "capture",
    "carbon",
    "image",
    "snippet",
    "share",
    "clipboard",
    "png",
    "export"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "termsnap-textwrap.capture",
        "title": "TermSnap: Capture Terminal Screenshot"
      }
    ],
    "keybindings": [
      {
        "command": "termsnap-textwrap.capture",
        "key": "ctrl+shift+s",
        "mac": "cmd+shift+s",
        "when": "terminalFocus && terminalHasBeenCreated"
      }
    ],
    "configuration": {
      "title": "TermSnap TextWrap",
      "properties": {
        "termsnap.theme": {
          "type": "string",
          "default": "andromeda",
          "enum": [
            "andromeda",
            "dracula",
            "one-dark",
            "monokai",
            "solarized-dark",
            "night-owl",
            "github-dark",
            "catppuccin-mocha",
            "tokyo-night",
            "gruvbox-dark",
            "nord",
            "solarized-light",
            "custom"
          ],
          "enumDescriptions": [
            "Andromeda theme",
            "Dracula theme",
            "One Dark theme",
            "Monokai theme",
            "Solarized Dark theme",
            "Night Owl theme",
            "GitHub Dark theme",
            "Catppuccin Mocha theme",
            "Tokyo Night theme",
            "Gruvbox Dark theme",
            "Nord theme",
            "Solarized Light theme",
            "Custom user-defined colors"
          ],
          "description": "Terminal screenshot theme"
        },
        "termsnap.fontSize": {
          "type": "number",
          "default": 14,
          "minimum": 10,
          "maximum": 24,
          "description": "Font size for terminal text"
        },
        "termsnap.padding": {
          "type": "number",
          "default": 16,
          "minimum": 0,
          "maximum": 64,
          "description": "Padding inside the terminal window"
        },
        "termsnap.preserveTerminalColors": {
          "type": "boolean",
          "default": true,
          "description": "Preserve colors and text styling from VS Code's Terminal: Copy Selection as HTML when the system clipboard supports text/html. Requires wl-paste on Linux Wayland or xclip on X11; otherwise falls back to plain text."
        },
        "termsnap.wrapText": {
          "type": "boolean",
          "default": false,
          "description": "Wrap long terminal lines in screenshots. Disable to preserve tables, ASCII art, and the original terminal alignment."
        },
        "termsnap.wrapWidth": {
          "type": "integer",
          "default": 800,
          "minimum": 240,
          "maximum": 2400,
          "description": "Terminal window width in pixels when text wrapping is enabled (excluding the outer screenshot background). Can also be adjusted in the preview."
        },
        "termsnap.showWindowControls": {
          "type": "boolean",
          "default": true,
          "description": "Show macOS-style window control dots"
        },
        "termsnap.showLineNumbers": {
          "type": "boolean",
          "default": false,
          "description": "Show line numbers in terminal output"
        },
        "termsnap.backgroundColor": {
          "type": "string",
          "default": "#1e1e2e",
          "description": "Background color behind the terminal window"
        },
        "termsnap.customBackground": {
          "type": "string",
          "default": "#1e1e2e",
          "description": "Custom theme: terminal background color"
        },
        "termsnap.customTextColor": {
          "type": "string",
          "default": "#f8f8f2",
          "description": "Custom theme: text color"
        },
        "termsnap.customTitleBarColor": {
          "type": "string",
          "default": "#161616",
          "description": "Custom theme: title bar color"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.72.0"
  },
  "dependencies": {
    "html-to-image": "^1.11.11"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@vscode/vsce@4.0.0": true
  }
}
